{
  // TYPE-CHECK ONLY — `npm run typecheck` (tsc --noEmit). There is deliberately
  // no build step in this repo: pi loads extension/*.ts as-is through jiti,
  // which STRIPS types without checking them. This config exists solely so the
  // types jiti ignores are actually checked; nothing here affects how pi loads
  // anything, and no emit is ever produced.
  "compilerOptions": {
    "noEmit": true,

    // --- Module system: match how pi/jiti actually loads these files ---------
    // jiti transpiles each file individually and resolves specifiers itself; it
    // does not impose Node's ESM/CJS file-type split (this package.json has no
    // "type" field, yet the sources use ESM syntax and load fine). "preserve" +
    // "bundler" is the faithful model, traced against the installed SDKs' real
    // export maps: @earendil-works/pi-ai exposes "./compat" ONLY through its
    // `exports` map (node10-style resolution cannot see it at all), all three pi
    // packages are "type": "module" with `types` conditions, and the sources
    // import relatives with an explicit ".ts" extension. "nodenext" would be
    // WRONG here: with no "type" field it classifies every source as CJS and
    // reports TS1479 on each ESM-only SDK import — a split jiti does not have.
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    // The first two hold today with zero errors, and both are what jiti's
    // per-file transpile actually requires. erasableSyntaxOnly is the third
    // member of the same family and carries a second job: it keeps every source
    // under extension/ executable by Node's stable native type stripping, which
    // is how the node:test suite imports these modules with no build step.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    // --- Runtime surface ----------------------------------------------------
    // pi requires Node >= 22.19; this repo runs on Node 24.
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],

    // --- Strictness ---------------------------------------------------------
    // Everything below is GREEN on the current tree. Adding a flag that is not
    // green turns this gate into a nuisance nobody runs, so any future addition
    // comes with the fix in the same change.
    "strict": true,
    // Its 9 sites were all provably-safe indexing that TS could not see; each was
    // made visible to the compiler (a length-test type guard in model-router.ts,
    // the loop bound stated with `!` in base-model.ts, `.at(-1)` in tools.ts)
    // rather than papered over with a fallback. The value is the NEXT index, the
    // unguarded one.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    // A side-effect-only import (`import "./x"`) is the one specifier TS resolves
    // silently by default: get the path wrong and the compiler says nothing while
    // jiti throws at load time. Green on the current tree, and cheap insurance for
    // a repo whose modules are loaded one by one rather than bundled.
    "noUncheckedSideEffectImports": true,

    // REQUIRED, not a convenience: with skipLibCheck off, the only additional
    // errors are 9 inside third-party declarations vendored under the pi SDK's
    // own node_modules (@anthropic-ai/sdk/internal/types.d.mts x6,
    // @google/genai/dist/genai.d.ts x3). They are unfixable from this repo and
    // say nothing about slate's code.
    "skipLibCheck": true

    // --- Evaluated and DEFERRED ---------------------------------------------
    // Recorded so these are not silently re-litigated. NEITHER found a genuine
    // type defect when last evaluated: every site was hand-checked and is safe.
    // No counts or per-file breakdowns are recorded here on purpose — the
    // include list moves them, and this comment carried stale numbers twice.
    // Re-derive the current diagnostics:
    //   npx --no-install tsc --noEmit -p tsconfig.json --exactOptionalPropertyTypes
    //   npx --no-install tsc --noEmit -p tsconfig.json --noPropertyAccessFromIndexSignature
    // (noUncheckedIndexedAccess and erasableSyntaxOnly were adopted above.)
    //
    // "exactOptionalPropertyTypes": The diagnostics distinguish an omitted
    //   property from an explicit undefined, across slate-owned declarations
    //   and calls into both slate and SDK option types. Those paths read with
    //   value-based fallbacks (`let model = options.model`,
    //   `if (options?.parentSession)`), and persisted records go through
    //   JSON.stringify, which drops undefined-valued keys. Moderate churn, low
    //   value — deferred, not rejected.
    //
    // "noPropertyAccessFromIndexSignature": REJECTED. The diagnostics are
    //   `t.id` / `t.episodeIds`-style reads of parsed JSON typed as
    //   Record<string, unknown>, plus process.env reads in the tests and the
    //   probe. Pure style churn, zero safety gain.
  },

  // extension/** is the shipped code. test/**/*.ts imports those shipped
  // modules, so the suite is checked too. verification/probe.ts is TypeScript
  // that imports the SDK and drives the real model-default module, and so is
  // verification/ci-canary.ts — the load check's positive control is a real pi
  // extension, and a type error in it would fake a load failure.
  // verification/*.mjs (the resolver-check, packaging-guard and coverage-gate
  // drivers) is plain, unannotated JavaScript: checking it would need
  // allowJs+checkJs and would measure a different codebase, so it is excluded.
  "include": ["extension/**/*.ts", "test/**/*.ts", "verification/probe.ts", "verification/ci-canary.ts"]
}
