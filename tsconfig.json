{
  // TYPE-CHECK ONLY — `npm run typecheck` (tsc --noEmit). There is deliberately
  // no build step in this repo: pi loads extension/*.ts as-is through jiti,
  // which STRIPS types without checking them. This config exists solely so the
  // types jiti ignores are actually checked; nothing here affects how pi loads
  // anything, and no emit is ever produced.
  "compilerOptions": {
    "noEmit": true,

    // --- Module system: match how pi/jiti actually loads these files ---------
    // jiti transpiles each file individually and resolves specifiers itself; it
    // does not impose Node's ESM/CJS file-type split (this package.json has no
    // "type" field, yet the sources use ESM syntax and load fine). "preserve" +
    // "bundler" is the faithful model, traced against the installed SDKs' real
    // export maps: @earendil-works/pi-ai exposes "./compat" ONLY through its
    // `exports` map (node10-style resolution cannot see it at all), the pi SDK
    // packages are "type": "module" with `types` conditions, and the sources
    // import relatives with an explicit ".ts" extension. "nodenext" would be
    // WRONG here: with no "type" field it classifies every source as CJS and
    // reports TS1479 on each ESM-only SDK import — a split jiti does not have.
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    // isolatedModules and verbatimModuleSyntax match jiti's per-file
    // transpile; erasableSyntaxOnly also keeps every shipped source executable
    // by Node's stable native type stripping, which runs the tests.
    // `npm run typecheck` validates these settings together with the rest.
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    // --- Runtime surface ----------------------------------------------------
    // pi requires Node >= 22.19.
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],

    // --- Strictness ---------------------------------------------------------
    // `npm run typecheck` must remain green. Adding a flag that is not green
    // turns this gate into a nuisance nobody runs, so any future addition comes
    // with the fix in the same change.
    "strict": true,
    // Provably-safe indexing that TS could not see was made visible to the
    // compiler (a length-test type guard in model-router.ts, the loop bound
    // stated with `!` in base-model.ts, `.at(-1)` in tools.ts) rather than
    // papered over with a fallback. The value is the NEXT index, the unguarded
    // one.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,

    // REQUIRED, not a convenience. At commit abac3bc, disabling it added
    // diagnostics only inside third-party declarations vendored under the pi
    // SDK's own node_modules. Re-check that boundary with:
    //   npx --no-install tsc --noEmit -p tsconfig.json --skipLibCheck false
    // Those declarations are unfixable from this repo and say nothing about
    // slate's code.
    "skipLibCheck": true

    // --- Evaluated and DEFERRED ---------------------------------------------
    // Recorded so these are not silently re-litigated. NONE found a genuine
    // type defect when last evaluated at commit 276441c; every site was
    // hand-checked and safe. Do not record moving counts or per-file breakdowns
    // here: the include list changes them. Re-derive the current diagnostics:
    //   npx --no-install tsc --noEmit -p tsconfig.json --exactOptionalPropertyTypes
    //   npx --no-install tsc --noEmit -p tsconfig.json --noPropertyAccessFromIndexSignature
    // (noUncheckedIndexedAccess and erasableSyntaxOnly were adopted above.)
    //
    // "exactOptionalPropertyTypes": The diagnostics distinguish omitted
    //   properties from explicit undefined across slate-owned records and calls
    //   into both slate and SDK option types. These paths use value-based
    //   fallbacks, and persisted records pass through JSON.stringify, which
    //   drops undefined-valued keys. Moderate churn, low value — deferred, not
    //   rejected.
    //
    // "noPropertyAccessFromIndexSignature": REJECTED. The diagnostics are
    //   `t.id` / `t.episodeIds`-style reads of parsed JSON typed as
    //   Record<string, unknown>, plus process.env reads in tests and the probe.
    //   Pure style churn, zero safety gain.
  },

  // extension/** is the shipped code. test/** and verification/probe.ts are
  // TypeScript that import shipped modules, so they are checked too.
  // verification/*.mjs is plain, unannotated JavaScript: checking it would need
  // allowJs+checkJs and would measure a different codebase, so it is excluded.
  "include": ["extension/**/*.ts", "test/**/*.ts", "verification/probe.ts"]
}
