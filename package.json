{
  "name": "ytdb-slate",
  "version": "0.10.0",
  "description": "Slate: thread-weaving orchestration for the pi coding agent — bounded worker actions, compressed episodes, mandatory research/design/adversarial/track review workflow, configurable model failover, and orchestrator context-budget handoff.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JetBrains/ytdb-slate.git"
  },
  "homepage": "https://github.com/JetBrains/ytdb-slate#readme",
  "keywords": [
    "pi-package"
  ],
  "files": [
    "extension",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bash verification/run-tests.sh",
    "test:coverage": "bash verification/run-tests.sh",
    "test:size-grade": "node verification/size-grade-tests.mjs",
    "coverage:gate": "node verification/coverage-gate.mjs",
    "link:peers": "bash verification/link-peers.sh"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "24.13.3",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
