{
  "orchestratorModeDefault": true,
  "workflow": { "draftPRs": true, "routingRecommendations": true },
  "router": {
    "models": {
      "include": [
        "luna-6",
        "claude-sonnet-5",
        "sol-6",
        "gemini-3.8-flash",
        "claude-opus-5.5",
        "gpt-6-astra"
      ]
    },
    "compressor": {
      "models": [{ "model": "claude-sonnet-5", "effort": "medium" }]
    }
  },
  "workerExtensions": ["pi-smart-fetch", "pi-web-search"]
}
