[
  {"rule":"format", "from":"format: 1", "to":"format: 2", "path":"$.format", "message":"format must be 1"},
  {"rule":"version", "from":"workflowVersion: 1", "to":"workflowVersion: zero", "path":"$.workflowVersion", "message":"version must"},
  {"rule":"workflow name", "from":"workflowId: slate-track", "to":"workflowId: Slate_Track", "path":"$.workflowId", "message":"name must match"},
  {"rule":"unknown field", "from":"format: 1", "to":"format: 1\nextra: no", "path":"$.extra", "message":"unknown field"},
  {"rule":"nested unknown field", "from":"type: boolean, description: Open draft", "to":"type: boolean, description: Open draft, extra: no", "path":"$.configuration[\"workflow.draftPRs\"].extra", "message":"unknown field"},
  {"rule":"configuration key", "from":"configuration:\n", "to":"configuration:\n  bad_key: { id: 18, type: boolean, description: Extra key }\n", "path":"$.configuration[\"bad_key\"]", "message":"configuration key must match"},
  {"rule":"duplicate ID", "from":"id: 17", "to":"id: 16", "path":"$.lifecycles[\"change\"].states[\"finished\"].id", "message":"duplicate id"},
  {"rule":"reserved name", "from":"  number: { id: 4", "to":"  __proto__: { id: 4", "path":"$.workflowArgs[\"__proto__\"]", "message":"name must match"},
  {"rule":"constructor name", "from":"  number: { id: 4", "to":"  constructor: { id: 4", "path":"$.workflowArgs[\"constructor\"]", "message":"name must match"},
  {"rule":"prototype name", "from":"  number: { id: 4", "to":"  prototype: { id: 4", "path":"$.workflowArgs[\"prototype\"]", "message":"name must match"},
  {"rule":"section reference", "from":"section: rules, priority: 1", "to":"section: absent, priority: 1", "path":"$.orchestrator[0].section", "message":"unresolved reference"},
  {"rule":"call reference", "from":"section: rules\n        on:", "to":"section: rules\n        call: missing\n        on:", "path":"$.lifecycles[\"change\"].states[\"work\"].call", "message":"unresolved reference"},
  {"rule":"guard reference", "from":"            - { id: 15, to: finished, when: ready }", "to":"            - { id: 15, to: finished, when: absent }\n            - { id: 18, to: finished, when: ready }", "path":"$.lifecycles[\"change\"].states[\"work\"].on[\"finish\"][0].when", "message":"unknown guard or condition"},
  {"rule":"guard cycle", "from":"expr: done", "to":"expr: { or: [ready, done] }", "path":"$.lifecycles[\"change\"].guards", "message":"cycle"},
  {"rule":"branch condition", "from":"to: finished, when: ready", "to":"to: finished, when: ready }\n            - { id: 18, to: finished", "path":"$.lifecycles[\"change\"].states[\"work\"].on[\"finish\"][1].when", "message":"multiple branches need when"},
  {"rule":"step completion in on", "from":"          finish:\n", "to":"          step_completed:\n            - { id: 18, to: finished, when: ready }\n          finish:\n", "path":"$.lifecycles[\"change\"].states[\"work\"].on[\"step_completed\"]", "message":"completion trigger"},
  {"rule":"root reference", "from":"root: change", "to":"root: missing", "path":"$.root", "message":"unresolved reference"},
  {"rule":"terminal path", "from":"            - { id: 15, to: finished, when: ready }\n      finished:", "to":"            - { id: 15, to: finished, when: ready }\n            - { id: 18, to: isolated, when: done }\n      isolated: { id: 19, description: Isolated }\n      finished:", "path":"$.lifecycles[\"change\"].states[\"isolated\"]", "message":"non-terminal state needs an ordinary transition path to a terminal state"},
  {"rule":"initial reachability", "from":"initialState: work", "to":"initialState: finished", "path":"$.lifecycles[\"change\"].states[\"work\"]", "message":"state must be reachable from initialState by ordinary transitions"},
  {"rule":"non-string mapping key", "from":"  number: { id: 4", "to":"  true: { id: 4", "path":"$[\"workflowArgs\"]", "message":"mapping keys must be plain string scalars"},
  {"rule":"trigger unused", "from":"      step_completed: { id: 13, description: Complete step }", "to":"      unused: { id: 18, description: Unused }\n      step_completed: { id: 13, description: Complete step }", "path":"$.lifecycles[\"change\"].triggers[\"unused\"]", "message":"unused declaration"},
  {"rule":"heading missing", "from":"heading: Rules", "to":"heading: Missing", "path":"$.sections[\"rules\"].heading", "message":"heading is missing"},
  {"rule":"unknown document", "from":"document: rules", "to":"document: absent", "path":"$.sections[\"rules\"].document", "message":"document refused"},
  {"rule":"handler source", "from":"handlers: test-handler", "to":"handlers: unavailable", "path":"$.handlers", "message":"handler source refused"},
  {"rule":"handler path", "from":"handlers: test-handler", "to":"handlers: ../outside", "path":"$.handlers", "message":"name must match"},
  {"rule":"steps mapping", "from":"    steps:\n      draft:\n        id: 17\n        description: Prepare draft\n        attachTo: work\n        when: { key: workflow.draftPRs, equals: true }\n        section: rules\n        completedBy: step_completed", "to":"    steps: []", "path":"$.lifecycles[\"change\"].steps", "message":"must be a mapping"},
  {"rule":"repeated YAML key", "from":"format: 1", "to":"format: 1\nformat: 1", "path":"$", "message":"Map keys must be unique"},
  {"rule":"YAML anchor", "from":"description: Test workflow", "to":"description: &anchor Test workflow", "path":"$[\"description\"]", "message":"anchors and tags are forbidden"},
  {"rule":"YAML alias", "from":"useWhen: Test changes", "to":"useWhen: *alias", "path":"$[\"useWhen\"]", "message":"aliases, anchors"},
  {"rule":"unknown YAML tag", "from":"description: Test workflow", "to":"description: !unknown Test workflow", "path":"$", "message":"Unresolved tag"},
  {"rule":"multiple documents", "from":"format: 1", "to":"format: 1\n---", "path":"$", "message":"exactly one YAML document"},
  {"rule":"missing field", "from":"useWhen: Test changes\n", "to":"", "path":"$.useWhen", "message":"required field"},
  {"rule":"empty description", "from":"description: Test workflow", "to":"description: ''", "path":"$.description", "message":"nonempty text"},
  {"rule":"bad configuration type", "from":"type: boolean", "to":"type: integer", "path":"$.configuration[\"workflow.draftPRs\"].type", "message":"configuration type must be boolean, enum or text"},
  {"rule":"enum values missing", "from":"type: boolean", "to":"type: enum", "path":"$.configuration[\"workflow.draftPRs\"].values", "message":"enum requires a nonempty list of text values"},
  {"rule":"values on boolean", "from":"type: boolean, description: Open draft", "to":"type: boolean, values: [yes], description: Open draft", "path":"$.configuration[\"workflow.draftPRs\"].values", "message":"values are allowed only for enum configuration"},
  {"rule":"bad document name", "from":"document: rules", "to":"document: ../rules", "path":"$.sections[\"rules\"].document", "message":"document name must match"},
  {"rule":"bad section shape", "from":"rules: { id: 2, document: rules, heading: Rules, description: Step rules }", "to":"rules: []", "path":"$.sections[\"rules\"]", "message":"must be a mapping"},
  {"rule":"argument type", "from":"type: integer, description: Number", "to":"type: boolean, description: Number", "path":"$.workflowArgs[\"number\"].type", "message":"argument type must be integer, text, enum or list"},
  {"rule":"prompt shape", "from":"prompt:\n      -", "to":"prompt: no\n      # -", "path":"$.threadTypes[\"reviewer\"].prompt", "message":"must be a list"},
  {"rule":"focus class", "from":"class: reviewer-only", "to":"class: unsupported", "path":"$.focusAreas[\"security\"].class", "message":"focus class must be design-triggering or reviewer-only"},
  {"rule":"focus definition", "from":"definition: rules", "to":"definition: absent", "path":"$.focusAreas[\"security\"].definition", "message":"unresolved reference"},
  {"rule":"guard unknown", "from":"expr: done", "to":"expr: missing", "path":"$.lifecycles[\"change\"].guards[\"ready\"].expr", "message":"unknown condition"},
  {"rule":"guard expression shape", "from":"expr: done", "to":"expr: []", "path":"$.lifecycles[\"change\"].guards[\"ready\"].expr", "message":"invalid guard expression"},
  {"rule":"condition guard namespace", "from":"      done: { id: 10, description: Work done }", "to":"      done: { id: 10, description: Work done }\n      ready: { id: 18, description: Duplicate }", "path":"$.lifecycles[\"change\"].guards[\"ready\"]", "message":"share a name"},
  {"rule":"step attachment", "from":"attachTo: work", "to":"attachTo: missing", "path":"$.lifecycles[\"change\"].steps[\"draft\"].attachTo", "message":"unresolved reference"},
  {"rule":"step predicate", "from":"when: { key: workflow.draftPRs, equals: true }", "to":"when: { key: workflow.draftPRs, present: false }", "path":"$.lifecycles[\"change\"].steps[\"draft\"].when", "message":"invalid step condition"},
  {"rule":"step configuration", "from":"key: workflow.draftPRs", "to":"key: workflow.absent", "path":"$.lifecycles[\"change\"].steps[\"draft\"].when.key", "message":"unresolved reference"},
  {"rule":"completion reference", "from":"completedBy: step_completed", "to":"completedBy: unknown", "path":"$.lifecycles[\"change\"].steps[\"draft\"].completedBy", "message":"unresolved reference"},
  {"rule":"branches empty", "from":"finish:\n            - { id: 15, to: finished, when: ready }", "to":"finish: []", "path":"$.lifecycles[\"change\"].states[\"work\"].on[\"finish\"]", "message":"nonempty list"},
  {"rule":"on mapping", "from":"        on:\n          finish:\n            - { id: 15, to: finished, when: ready }", "to":"        on: []", "path":"$.lifecycles[\"change\"].states[\"work\"].on", "message":"on must be a mapping"},
  {"rule":"branch target", "from":"to: finished, when: ready", "to":"to: absent, when: ready", "path":"$.lifecycles[\"change\"].states[\"work\"].on[\"finish\"][0].to", "message":"unresolved reference"},
  {"rule":"branch shape", "from":"- { id: 15, to: finished, when: ready }", "to":"- []", "path":"$.lifecycles[\"change\"].states[\"work\"].on[\"finish\"][0]", "message":"branch must be a mapping"},
  {"rule":"else order", "from":"- { id: 15, to: finished, when: ready }", "to":"- { id: 15, else: finished }", "path":"$.lifecycles[\"change\"].states[\"work\"].on[\"finish\"][0]", "message":"else must be last"},
  {"rule":"terminal flag", "from":"terminal: true", "to":"terminal: always", "path":"$.lifecycles[\"change\"].states[\"finished\"].terminal", "message":"must be boolean"},
  {"rule":"terminal on", "from":"terminal: true", "to":"terminal: true, on: {}", "path":"$.lifecycles[\"change\"].states[\"finished\"]", "message":"terminal state cannot"},
  {"rule":"call cycle", "from":"section: rules\n        on:", "to":"section: rules\n        call: change\n        on:", "path":"$.lifecycles", "message":"call cycle"},
  {"rule":"priority", "from":"section: rules, priority: 1", "to":"section: rules, priority: high", "path":"$.orchestrator[0].priority", "message":"priority must be an integer"},
  {"rule":"id range", "from":"id: 17", "to":"id: -1", "path":"$.lifecycles[\"change\"].steps[\"draft\"].id", "message":"positive integer"},
  {"rule":"trigger reference", "from":"          finish:\n", "to":"          unknown:\n", "path":"$.lifecycles[\"change\"].states[\"work\"].on[\"unknown\"]", "message":"unresolved reference"},
  {"rule":"explicit YAML tag", "from":"description: Test workflow", "to":"description: !!str Test workflow", "path":"$[\"description\"]", "message":"anchors and tags"}
]
